# Contact form email delivery. Keep these server-only, never NEXT_PUBLIC_.
# Set these in .env.local for local use, or in Vercel project environment variables.
RESEND_API_KEY=
# Verified sending domain; defaults to Dansran <requests@domain>.
RESEND_EMAIL_DOMAIN=dansran.shop
# Optional override for the sender address, on a domain verified in Resend.
RESEND_FROM=

# Legacy database connection; not required for contact form email delivery.
DATABASE_URL=
